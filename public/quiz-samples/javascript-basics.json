      "id": "js-3",
      "type": "multiple",
      "content": "以下哪些方法可以创建一个新对象？",
      "options": [
        { "id": "a", "text": "Object.create()" },
        { "id": "b", "text": "new Object()" },
        { "id": "c", "text": "字面量 {}" },
        { "id": "d", "text": "Object.assign()" }
      ],
      "correctAnswers": ["a", "b", "c"],
